# ============================================
# TEMPLATE ONLY — DO NOT PUT REAL VALUES HERE.
#
# This file IS committed to git. The blank keys below are blank on purpose.
# The real values belong in .env.production on the server, which is ignored
# by git and never leaves the server.
#
# Regenerated by scripts/package-production.js on every run, so anything you
# type here is discarded anyway.
# ============================================
# ─────────────────────────────────────────────────────────────
# Production environment for sys.atline.com.my
#
# NOT committed: .gitignore excludes .env.* in both this repo and the generated
# bundle, and package-production.js publishes only .env.example with every
# SECRET/PASSWORD blanked, then refuses to continue if one slips through.
#
# ── Which copy actually wins ──
#
# cPanel's Node.js App page holds the same variables, and sourcing
# ~/nodevenv/<app>/<ver>/bin/activate exports them into the environment. dotenv
# does NOT overwrite a variable that is already set, so on the server the cPanel
# values win and this file is the fallback.
#
# That fallback matters: .cpanel.yml deploys with `cp -R . $DEPLOYPATH/`, which
# overwrites .htaccess and therefore removes the CLOUDLINUX ENV VARS block until
# cPanel rewrites it. Without these values the app would lose the database in that
# window. Keep this file and the cPanel page in step — if they disagree, the
# cPanel page is what runs.
# ─────────────────────────────────────────────────────────────

# ── Database ──
# Account khisdsb123. Both the user and the schema are khisdsb123_sys.
DB_HOST=localhost
DB_PORT=3306
DB_USER=khisdsb123_sys
DB_PASSWORD=
DB_NAME=khisdsb123_sys

# ── Signing secrets ──
# JWT_SECRET signs both the admin cookie and the staff app's 30-day Bearer token.
# Changing it signs every user and every handset out at once.
JWT_SECRET=
NEXTAUTH_SECRET=
REVALIDATE_SECRET=

# ── URLs ──
NEXTAUTH_URL=https://sys.atline.com.my
APP_PUBLIC_URL=https://sys.atline.com.my
NEXT_PUBLIC_WEBSITE_URL=https://www.atline.com.my

NODE_ENV=production
